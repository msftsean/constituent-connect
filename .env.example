# Local synthetic mode only. Do not place secrets or credentials in this file.
CC_PROJECT_ROOT=/workspaces/constituent-connect
CC_CONFIG_PATH=/workspaces/constituent-connect/config/app.json
CC_HOST=127.0.0.1
CC_PORT=8000
CC_ENABLE_AZURE_AI_SEARCH=false
CC_ENABLE_COSMOS_DB=false
CC_ENABLE_COMMUNICATION_SERVICES=false
# Optional team namespace for shared workshop hosts.
CC_TEAM_ID=local

# Optional local token-backed approval. Leave unset in committed files; the
# readiness script writes generated local values to the untracked .env file.
# CC_LOCAL_WORKSHOP_APPROVAL=false
# CONSTITUENT_CONNECT_APPROVER_ID=
# CONSTITUENT_CONNECT_APPROVER_TOKEN=
