{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=eastus2}"
    },
    "containerImage": {
      "value": "${SERVICE_WEB_IMAGE=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "minReplicas": {
      "value": 1
    },
    "maxReplicas": {
      "value": 3
    },
    "logRetentionInDays": {
      "value": 90
    },
    "enableCommunicationServices": {
      "value": false
    },
    "communicationServicesDataLocation": {
      "value": "United States"
    }
  }
}
