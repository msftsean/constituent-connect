{
  "name": "Maryland Constituent Connect",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Constituent Connect",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python -m pip install -e . && python scripts/readiness.py",
  "remoteUser": "vscode"
}
